---
# Include ordering rules for Cinnabar1 - see Source/CBR/Documentation/Include_ordering.txt
BasedOnStyle: InheritParentConfig
SortIncludes:
  Enabled: true
  IgnoreCase: false
IncludeBlocks: Regroup
IncludeIsMainRegex: '$'
MainIncludeChar: Quote
IncludeCategories:
  # CBR project headers
  - Regex: '^"'
    Priority: 1
  - Regex: '^<CBR/'
    Priority: 1
  - Regex: '^<(Engine|Stream_io_overloads)\.hpp>$'
    Priority: 1
  # Engine headers
  - Regex: '^<(Hobgoblin|SPeMPE|GridGoblin)/'
    Priority: 2
  # Standard library headers
  - Regex: '^<[a-z0-9_]+>$'
    Priority: 4
  # 3rd party headers
  - Regex: '.*'
    Priority: 3
